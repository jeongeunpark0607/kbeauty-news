# 이 파일을 복사해 ".env" 로 저장하고 실제 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).
# GitHub Actions에서 자동 실행할 때는 이 값들을 리포지토리의
# Settings > Secrets and variables > Actions > New repository secret 에 동일한 이름으로 등록합니다.

# 2026년 기준 네이버 뉴스 검색 API는 "NAVER API HUB"(네이버클라우드플랫폼,
# https://apihub.naver.com)에서 발급받습니다 (기존 개발자센터에는 더 이상 검색 API가
# 없습니다). 네이버클라우드플랫폼 계정으로 로그인 후 콘솔에서
# All Services > Application Services > NAVER API HUB > 신청하기 로 들어가
# 뉴스 검색 API를 구독하고 Application을 생성하면 아래 두 값이 발급됩니다.
# (README 3-1절 참고)
NAVER_CLIENT_ID=여기에_API_Key_ID
NAVER_CLIENT_SECRET=여기에_API_Key
# hub(기본값, NAVER API HUB) 또는 legacy(2027-06-30까지 유효한 구 개발자센터 키를
# 이미 갖고 있는 경우)
NAVER_API_MODE=hub

# Anthropic Console(https://console.anthropic.com/settings/keys) 에서 발급
ANTHROPIC_API_KEY=여기에_Anthropic_API_키
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Slack 앱 > Incoming Webhooks 에서 발급
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/여기에/웹훅/주소

# (선택) 수집 윈도우 / 1회 검색당 최대 수집 건수
COLLECT_WINDOW_HOURS=24
NAVER_DISPLAY_COUNT=30
